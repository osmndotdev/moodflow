# Copy to .env (git-ignored). Server-side developer keys only — never sent to the browser.
# End users log in only if they choose to save a playlist to their own Spotify / YouTube account.

# Primary source for all five features (free key: https://freqblog.com/#pricing)
FREQBLOG_API_KEY=

# Fallbacks, only called for fields still missing; skipped when empty
GETSONGBPM_API_KEY=
LASTFM_API_KEY=

# Keyless fallbacks (1 = on, 0 = off)
# ReccoBeats audio features for missing BPM / key (right after FreqBlog)
MOODFLOW_RECCOBEATS=1
# MusicBrainz artist genres for missing genre (rate limit: 1 request/second)
MOODFLOW_MUSICBRAINZ=1
# Seconds per import MusicBrainz may spend before remaining genres stay empty
MOODFLOW_MUSICBRAINZ_BUDGET=15

# Matching: max duration difference (s) between playlist item and provider hit
MOODFLOW_DURATION_TOLERANCE=20

# Playlist items read per import (more items = more feature-API lookups on a first import)
MOODFLOW_MAX_TRACKS=50

# YouTube playlist reading + yt-dlp downloads need no OAuth.
# Spotify public adapter is experimental; importing never asks for a login.

# Optional playlist export to the user's own account (OAuth; leave empty to turn export off).
# Redirect URIs to register: <MOODFLOW_PUBLIC_URL>/api/export/spotify/callback and .../youtube/callback
# Spotify app: https://developer.spotify.com/dashboard (Web API)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Google Cloud OAuth client (Web application) with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origin the providers redirect back to; default http://127.0.0.1:<MOODFLOW_PORT>.
# Spotify rejects "localhost" (use 127.0.0.1) and needs https for anything but a loopback IP.
MOODFLOW_PUBLIC_URL=

# API server (`python -m backend`); the Vite dev proxy reads MOODFLOW_PORT too
MOODFLOW_HOST=127.0.0.1
MOODFLOW_PORT=8000
# Auto-reload the API on backend/*.py edits (python -m backend, ./dev.sh)
MOODFLOW_RELOAD=1

# Scratch dir for downloaded audio, feature cache and rendered mixes
MOODFLOW_TMP=./tmp
MOODFLOW_MIX_TTL=3600
MOODFLOW_CACHE_TTL=172800
# Feature API answers (tmp/cache/provider_cache.json): days to reuse hits / "not found" answers
MOODFLOW_PROVIDER_CACHE_DAYS=30
MOODFLOW_PROVIDER_CACHE_NEGATIVE_DAYS=7
MOODFLOW_LOG=INFO

# Microsoft Clarity project ID (public, it ends up in the served page). Set it ONLY in the VPS .env (MOODFLOW_CLARITY_ID=zhr0drdbro) so
# that only the deployed site collects analytics; leave empty everywhere else (local dev, tests).
MOODFLOW_CLARITY_ID=
